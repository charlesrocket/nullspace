#!/bin/sh

if [ -z "$XDG_RUNTIME_DIR" ]; then
    XDG_RUNTIME_DIR="/tmp/$(id -u)-runtime-dir"

    mkdir -p "$XDG_RUNTIME_DIR"
    chmod 0700 "$XDG_RUNTIME_DIR"

    export XDG_RUNTIME_DIR
fi

if [ -n "$DBUS_SESSION_BUS_ADDRESS" ]; then
    exec nullspace
else
    exec dbus-run-session nullspace
fi
